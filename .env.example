APP_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_MIGRATION_URL=postgresql://user:pass@host/db?sslmode=require

AI_PROVIDER_ORDER=deepseek
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

AWS_REGION=ap-southeast-1
# BEDROCK_AGENT_RUNTIME_ARN=   # pending G9

SAFETY_ENABLED=true
SAFETY_CLASSIFIER_ENABLED=false

# Parent authentication (Better Auth + email OTP)
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
APP_ORIGIN=http://localhost:3000
PARENT_OTP_TTL_MIN=10

# Email delivery — AWS SES over SMTP. Absent in development: codes go to the
# server log. Credentials come from the SES console as a CSV; the password is
# DERIVED from a secret key, so it is not an IAM key pair and the SESv2 HTTPS
# API cannot be used with it.
SES_SMTP_HOST=email-smtp.ap-southeast-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=
SES_SMTP_PASSWORD=
# Must be an identity SES has verified, or every send is rejected.
EMAIL_FROM=Bubbli <no-reply@example.com>

# Child device pairing
DEVICE_PAIRING_TTL_MIN=15
DEVICE_TRUST_DAYS=30
